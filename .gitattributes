# Git attributes for cross-platform compatibility
# Ensures consistent line endings for shell scripts

# Shell scripts must use LF line endings
*.sh text eol=lf

# Batch scripts use CRLF (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# All other text files - auto-detect
* text=auto

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
