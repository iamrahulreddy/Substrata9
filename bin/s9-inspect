#!/usr/bin/env bash
#
# s9-inspect - Deep process inspection tool
# Substrata9
#
# Author: Muskula Rahul
#
# Usage: s9-inspect <PID|process_name> [options]
#
# Requirements: bash 4.0+, Linux with /proc filesystem
#

# Note: Using set -uo pipefail (without -e) to handle race conditions
# when processes exit during inspection

set -uo pipefail

#------------------------------------------------------------------------------
# Source Common Library
#------------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/s9-common.sh
source "${SCRIPT_DIR}/../lib/s9-common.sh" 2>/dev/null || \
source "${SCRIPT_DIR}/../lib/substrata9/s9-common.sh" 2>/dev/null || \
source "/usr/local/lib/substrata9/s9-common.sh" 2>/dev/null || \
{ echo "Error: Cannot find s9-common.sh library"; exit 1; }

#------------------------------------------------------------------------------
# Configuration
#------------------------------------------------------------------------------
SHOW_MEMORY_DETAILS=false
QUIET_MODE=false
JSON_MODE=false
PROC_BASE="/proc"
EXPORT_FILE=""
AUTO_EXPORT_JSON=false

#------------------------------------------------------------------------------
# Inspection Functions
#------------------------------------------------------------------------------

inspect_basic() {
    local pid=$1
    local proc_dir="$PROC_BASE/$pid"

    # Check process still exists
    [[ -r "$proc_dir/status" ]] || s9_die "Process $pid no longer exists"

    s9_header "PROCESS IDENTITY"

    # Read status file once for efficiency
    local status_content
    status_content=$(cat "$proc_dir/status" 2>/dev/null) || s9_die "Cannot read process status"

    # Parse all fields from single read
    local name state ppid uid threads
    name=$(s9_sanitize_display "$(echo "$status_content" | grep "^Name:" | cut -f2-)")
    state=$(echo "$status_content" | grep "^State:" | awk '{print $2, $3}')
    ppid=$(echo "$status_content" | grep "^PPid:" | awk '{print $2}')
    uid=$(echo "$status_content" | grep "^Uid:" | awk '{print $2}')
    threads=$(echo "$status_content" | grep "^Threads:" | awk '{print $2}')

    # Get username from UID
    local username
    username=$(s9_uid_to_user "$uid")

    # Executable path
    local exe
    exe=$(readlink "$proc_dir/exe" 2>/dev/null || echo "(permission denied)")

    # Command line
    local cmdline
    cmdline=$(tr '\0' ' ' < "$proc_dir/cmdline" 2>/dev/null || echo "(unavailable)")
    [[ -z "$cmdline" ]] && cmdline="(kernel thread)"

    # Current working directory
    local cwd
    cwd=$(readlink "$proc_dir/cwd" 2>/dev/null || echo "(permission denied)")

    # Start time calculation
    local start_time_ticks uptime_seconds hz start_seconds start_date
    start_time_ticks=$(s9_get_stat_field "$pid" 22 2>/dev/null || echo "0")
    uptime_seconds=$(awk '{print $1}' /proc/uptime)
    hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
    hz=${hz:-100}
    local uptime_int=${uptime_seconds%.*}
    start_seconds=$(( uptime_int - (start_time_ticks / hz) ))
    start_date=$(date -d "@$(($(date +%s) - start_seconds))" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "unknown")

    # Process age
    local age_str
    age_str=$(s9_human_duration "$start_seconds")

    # Parent name
    local parent_name
    parent_name=$(s9_get_comm "$ppid")

    # State color
    local state_color="$S9_NC"
    case "${state%% *}" in
        R) state_color="$S9_GREEN" ;;
        S) state_color="$S9_CYAN" ;;
        D) state_color="$S9_YELLOW" ;;
        Z) state_color="$S9_RED" ;;
        T|t) state_color="$S9_YELLOW" ;;
    esac

    s9_kv "PID" "$pid"
    s9_kv "Name" "$name"
    s9_kv "State" "$state" 15 "$state_color"
    s9_kv "Parent" "$parent_name (PID $ppid)"
    s9_kv "User" "$username (UID $uid)"
    s9_kv "Threads" "$threads"
    s9_kv "Started" "$start_date ($age_str ago)"

    s9_kv "Executable" "$exe"
    s9_kv "Working Dir" "$cwd"

    if (( ${#cmdline} > 60 )); then
        s9_kv "Command" "${cmdline:0:60}..."
    else
        s9_kv "Command" "$cmdline"
    fi
}

inspect_memory() {
    local pid=$1
    local proc_dir="$PROC_BASE/$pid"

    s9_header "MEMORY"

    # Read status file once for efficiency (avoid TOCTOU and improve performance)
    local status_content
    status_content=$(s9_read_proc_file "$proc_dir/status") || {
        printf "  %b(Cannot read process status)%b\n" "${S9_YELLOW}" "${S9_NC}"
        return
    }

    # Get memory stats from single read
    local vmsize vmrss vmdata vmstk vmexe vmlib vmpeak vmswap
    vmsize=$(echo "$status_content" | grep "^VmSize:" | awk '{print $2}')
    vmrss=$(echo "$status_content" | grep "^VmRSS:" | awk '{print $2}')
    vmdata=$(echo "$status_content" | grep "^VmData:" | awk '{print $2}')
    vmstk=$(echo "$status_content" | grep "^VmStk:" | awk '{print $2}')
    vmexe=$(echo "$status_content" | grep "^VmExe:" | awk '{print $2}')
    vmlib=$(echo "$status_content" | grep "^VmLib:" | awk '{print $2}')
    vmpeak=$(echo "$status_content" | grep "^VmPeak:" | awk '{print $2}')
    vmswap=$(echo "$status_content" | grep "^VmSwap:" | awk '{print $2}')

    # Default to 0 if empty
    vmsize=${vmsize:-0}; vmrss=${vmrss:-0}; vmdata=${vmdata:-0}
    vmstk=${vmstk:-0}; vmexe=${vmexe:-0}; vmlib=${vmlib:-0}
    vmpeak=${vmpeak:-0}; vmswap=${vmswap:-0}

    # Handle kernel threads (no memory info)
    if [[ "$vmsize" == "0" ]] && [[ ! -f "$proc_dir/maps" ]]; then
        printf "  %b(Kernel thread - no user-space memory)%b\n" "${S9_DIM}" "${S9_NC}"
        return
    fi

    # Calculate percentages
    local total_mem mem_percent
    total_mem=$(s9_get_total_mem)
    total_mem=${total_mem:-0}
    if (( total_mem > 0 )); then
        local mem_int=$(( (vmrss * 100) / total_mem ))
        local mem_dec=$(( ((vmrss * 10000) / total_mem) % 100 ))
        mem_percent=$(printf "%d.%02d" "$mem_int" "$mem_dec")
    else
        mem_percent="0.00"
    fi

    # Memory color based on usage
    local mem_color="$S9_GREEN"
    local mem_pct_int=${mem_percent%.*}
    if (( mem_pct_int > 50 )); then mem_color="$S9_RED"
    elif (( mem_pct_int > 25 )); then mem_color="$S9_YELLOW"; fi

    s9_kv "Virtual Size" "$vmsize kB ($(s9_human_kb "$vmsize"))" 18
    printf "  %b%-18s%b %s kB (%s) — %b%.2f%% of system%b\n" \
        "${S9_BOLD}" "Resident (RSS):" "${S9_NC}" "$vmrss" "$(s9_human_kb "$vmrss")" "$mem_color" "$mem_percent" "${S9_NC}"
    s9_kv "Peak Virtual" "$vmpeak kB" 18

    echo ""
    printf "  %b%-12s  %-12s  %-12s  %-12s%b\n" "${S9_DIM}" "Data" "Stack" "Code" "Libraries" "${S9_NC}"
    printf "  %-12s  %-12s  %-12s  %-12s\n" \
        "$(s9_human_kb "$vmdata")" "$(s9_human_kb "$vmstk")" "$(s9_human_kb "$vmexe")" "$(s9_human_kb "$vmlib")"

    if (( vmswap > 0 )); then
        echo ""
        printf "  %b⚠ Swap:%b %s kB swapped out\n" "${S9_YELLOW}" "${S9_NC}" "$vmswap"
    fi

    if $SHOW_MEMORY_DETAILS; then
        echo ""
        printf "  %bMemory Regions (from /proc/$pid/maps):%b\n" "${S9_DIM}" "${S9_NC}"
        printf "  %b─────────────────────────────────────────────────────────────%b\n" "${S9_DIM}" "${S9_NC}"

        # Parse and display memory map with colors
        awk -v green="${S9_GREEN}" -v yellow="${S9_YELLOW}" -v dim="${S9_DIM}" -v nc="${S9_NC}" '{
            addr = $1
            perms = $2
            path = $6
            if (path == "") path = "[anonymous]"

            # Color based on permissions
            if (perms ~ /x/) color = green      # Green for executable
            else if (perms ~ /w/) color = yellow # Yellow for writable
            else color = dim                     # Dim for read-only

            printf "  %b%-24s %s  %s%b\n", color, addr, perms, path, nc
        }' "$proc_dir/maps" 2>/dev/null | head -20

        local map_count
        map_count=$(wc -l < "$proc_dir/maps" 2>/dev/null || echo "0")
        if (( map_count > 20 )); then
            printf "  %b... and %d more regions%b\n" "${S9_DIM}" "$((map_count - 20))" "${S9_NC}"
        fi
    fi
}

inspect_file_descriptors() {
    local pid=$1
    local proc_dir="$PROC_BASE/$pid"
    local fd_dir="$proc_dir/fd"

    s9_header "FILE DESCRIPTORS"

    if [[ ! -r "$fd_dir" ]]; then
        printf "  %b(Permission denied - run as root for full access)%b\n" "${S9_YELLOW}" "${S9_NC}"
        return
    fi

    local fd_count
    fd_count=$(ls -1 -- "$fd_dir" 2>/dev/null | wc -l)

    printf "  ${S9_BOLD}Open FDs:${S9_NC} %d\n\n" "$fd_count"

    # Categorize all file descriptors before displaying the truncated table.
    local files=0 sockets=0 pipes=0 devices=0 other=0
    local fd_path target fd_type

    local restore_nullglob=false
    if ! shopt -q nullglob; then
        restore_nullglob=true
        shopt -s nullglob
    fi

    for fd_path in "$fd_dir"/*; do
        [[ -e "$fd_path" ]] || continue
        target=$(readlink "$fd_path" 2>/dev/null || echo "(unreadable)")
        fd_type=$(s9_fd_type "$target")

        case "$fd_type" in
            file) ((files++)) ;;
            socket) ((sockets++)) ;;
            pipe) ((pipes++)) ;;
            device) ((devices++)) ;;
            *) ((other++)) ;;
        esac
    done

    $restore_nullglob && shopt -u nullglob

    printf "  %bFD   Type      Target%b\n" "${S9_DIM}" "${S9_NC}"
    printf "  %b───  ────────  ──────────────────────────────────────────%b\n" "${S9_DIM}" "${S9_NC}"

    for fd in $(ls -- "$fd_dir" 2>/dev/null | sort -n | head -30); do
        target=$(readlink "$fd_dir/$fd" 2>/dev/null || echo "(unreadable)")

        local color
        fd_type=$(s9_fd_type "$target")
        case "$fd_type" in
            socket)
                color="$S9_CYAN"
                ;;
            pipe)
                color="$S9_YELLOW"
                ;;
            device)
                color="$S9_BLUE"
                ;;
            anon)
                color="$S9_DIM"
                ;;
            *)
                color="$S9_GREEN"
                ;;
        esac

        printf "  ${S9_BOLD}%-3s${S9_NC}  %b%-8s${S9_NC}  %s\n" "$fd" "$color" "$fd_type" "${target:0:50}"
    done

    if (( fd_count > 30 )); then
        printf "  %b... and %d more%b\n" "${S9_DIM}" "$((fd_count - 30))" "${S9_NC}"
    fi

    echo ""
    printf "  %bSummary: %d files, %d sockets, %d pipes, %d devices, %d other%b\n" \
        "${S9_DIM}" "$files" "$sockets" "$pipes" "$devices" "$other" "${S9_NC}"
}

inspect_signals() {
    local pid=$1
    local proc_dir="$PROC_BASE/$pid"

    s9_header "SIGNALS"

    # Read status file once
    local status_content
    status_content=$(s9_read_proc_file "$proc_dir/status") || {
        printf "  %b(Cannot read process status)%b\n" "${S9_YELLOW}" "${S9_NC}"
        return
    }

    local sigblk sigign sigcgt sigpnd
    sigblk=$(echo "$status_content" | grep "^SigBlk:" | awk '{print $2}')
    sigign=$(echo "$status_content" | grep "^SigIgn:" | awk '{print $2}')
    sigcgt=$(echo "$status_content" | grep "^SigCgt:" | awk '{print $2}')
    sigpnd=$(echo "$status_content" | grep "^SigPnd:" | awk '{print $2}')
    sigblk=${sigblk:-0}; sigign=${sigign:-0}; sigcgt=${sigcgt:-0}; sigpnd=${sigpnd:-0}

    printf "  ${S9_BOLD}%-12s${S9_NC} %s\n" "Blocked:" "$(s9_decode_signals "$sigblk")"
    printf "  ${S9_BOLD}%-12s${S9_NC} %s\n" "Ignored:" "$(s9_decode_signals "$sigign")"
    printf "  ${S9_BOLD}%-12s${S9_NC} %s\n" "Caught:" "$(s9_decode_signals "$sigcgt")"
    printf "  ${S9_BOLD}%-12s${S9_NC} %s\n" "Pending:" "$(s9_decode_signals "$sigpnd")"
}

inspect_limits() {
    local pid=$1
    local proc_dir="$PROC_BASE/$pid"

    s9_header "RESOURCE LIMITS"

    if [[ ! -r "$proc_dir/limits" ]]; then
        printf "  %b(Permission denied)%b\n" "${S9_YELLOW}" "${S9_NC}"
        return
    fi

    printf "  %bLimit                     Soft Limit           Hard Limit%b\n" "${S9_DIM}" "${S9_NC}"
    printf "  ${S9_DIM}────────────────────────  ───────────────────  ───────────────────${S9_NC}\n"

    awk '
        /^Max processes[[:space:]]/ {
            name = $1 " " $2
            printf "  %-24s  %-19s  %-19s\n", name, $(NF-2), $(NF-1)
            next
        }
        /^(Max open files|Max stack size|Max resident set|Max address space)[[:space:]]/ {
            name = $1 " " $2 " " $3
            printf "  %-24s  %-19s  %-19s\n", name, $(NF-2), $(NF-1)
        }
    ' "$proc_dir/limits"
}

inspect_io() {
    local pid=$1
    local proc_dir="$PROC_BASE/$pid"

    s9_header "I/O STATISTICS"

    if [[ ! -r "$proc_dir/io" ]]; then
        printf "  %b(Permission denied - run as root)%b\n" "${S9_YELLOW}" "${S9_NC}"
        return
    fi

    # Read io file once
    local io_content
    io_content=$(s9_read_proc_file "$proc_dir/io") || {
        printf "  %b(Cannot read I/O stats)%b\n" "${S9_YELLOW}" "${S9_NC}"
        return
    }

    local rchar wchar rbytes wbytes syscr syscw
    rchar=$(echo "$io_content" | grep "^rchar:" | awk '{print $2}')
    wchar=$(echo "$io_content" | grep "^wchar:" | awk '{print $2}')
    rbytes=$(echo "$io_content" | grep "^read_bytes:" | awk '{print $2}')
    wbytes=$(echo "$io_content" | grep "^write_bytes:" | awk '{print $2}')
    syscr=$(echo "$io_content" | grep "^syscr:" | awk '{print $2}')
    syscw=$(echo "$io_content" | grep "^syscw:" | awk '{print $2}')

    # Ensure we have valid numbers
    [[ "$rchar" =~ ^[0-9]+$ ]] || rchar=0
    [[ "$wchar" =~ ^[0-9]+$ ]] || wchar=0
    [[ "$rbytes" =~ ^[0-9]+$ ]] || rbytes=0
    [[ "$wbytes" =~ ^[0-9]+$ ]] || wbytes=0

    printf "  ${S9_BOLD}%-20s${S9_NC} %s (%s)\n" "Characters Read:" "$rchar" "$(s9_human_bytes "$rchar")"
    printf "  ${S9_BOLD}%-20s${S9_NC} %s (%s)\n" "Characters Written:" "$wchar" "$(s9_human_bytes "$wchar")"
    printf "  ${S9_BOLD}%-20s${S9_NC} %s (%s)\n" "Bytes Read (disk):" "$rbytes" "$(s9_human_bytes "$rbytes")"
    printf "  ${S9_BOLD}%-20s${S9_NC} %s (%s)\n" "Bytes Written (disk):" "$wbytes" "$(s9_human_bytes "$wbytes")"
    printf "  ${S9_BOLD}%-20s${S9_NC} %s read, %s write\n" "Syscalls:" "$syscr" "$syscw"
}

inspect_gpu() {
    local pid=$1
    local gpu_row

    gpu_row=$(s9_gpu_process_for_pid "$pid" 2>/dev/null) || return 0

    local gpu_index gpu_name gpu_memory gpu_type
    IFS='|' read -r _ _ gpu_index gpu_name gpu_memory gpu_type <<< "$gpu_row"

    s9_header "GPU"
    s9_kv "GPU" "${gpu_name:-unknown} (${gpu_index:-unknown})"
    s9_kv "GPU Memory" "${gpu_memory:-0} MB"
    s9_kv "GPU Type" "${gpu_type:-compute}"
}

inspect_json() {
    local pid=$1
    local proc_dir="$PROC_BASE/$pid"

    echo "{"

    # Basic Info
    local status_content
    status_content=$(cat "$proc_dir/status" 2>/dev/null) || { echo "  \"error\": \"Cannot read process status\""; echo "}"; return; }

    local name state ppid uid threads
    name=$(s9_sanitize_display "$(echo "$status_content" | grep "^Name:" | awk '{print $2}')")
    state=$(echo "$status_content" | grep "^State:" | awk '{print $2}')
    ppid=$(echo "$status_content" | grep "^PPid:" | awk '{print $2}')
    uid=$(echo "$status_content" | grep "^Uid:" | awk '{print $2}')
    threads=$(echo "$status_content" | grep "^Threads:" | awk '{print $2}')
    local username
    username=$(s9_uid_to_user "$uid")
    local exe
    exe=$(readlink "$proc_dir/exe" 2>/dev/null || echo "")
    local cmdline
    cmdline=$(tr '\0' ' ' < "$proc_dir/cmdline" 2>/dev/null || echo "")
    local cwd
    cwd=$(readlink "$proc_dir/cwd" 2>/dev/null || echo "")

    s9_json_kv "pid" "$pid"
    s9_json_kv "name" "$name"
    s9_json_kv "state" "$state"
    s9_json_kv "ppid" "$ppid"
    s9_json_kv "uid" "$uid"
    s9_json_kv "user" "$username"
    s9_json_kv "threads" "$threads"
    s9_json_kv "exe" "$exe"
    s9_json_kv "cwd" "$cwd"
    s9_json_kv "cmdline" "$cmdline"

    # Memory
    local vmsize vmrss
    vmsize=$(echo "$status_content" | grep "^VmSize:" | awk '{print $2}')
    vmrss=$(echo "$status_content" | grep "^VmRSS:" | awk '{print $2}')
    vmsize=${vmsize:-0}
    vmrss=${vmrss:-0}

    s9_json_kv "vm_size_kb" "$vmsize"
    s9_json_kv "rss_kb" "$vmrss"

    # FDs
    local fd_count
    fd_count=$(s9_get_fd_count "$pid")
    s9_json_kv "fd_count" "$fd_count"

    # IO
    if [[ -r "$proc_dir/io" ]]; then
        local io_content
        io_content=$(cat "$proc_dir/io" 2>/dev/null)
        local rchar wchar
        rchar=$(echo "$io_content" | grep "^rchar:" | awk '{print $2}')
        wchar=$(echo "$io_content" | grep "^wchar:" | awk '{print $2}')
        s9_json_kv "io_read_chars" "${rchar:-0}"
        s9_json_kv "io_write_chars" "${wchar:-0}"
    else
        s9_json_kv "io_read_chars" "0"
        s9_json_kv "io_write_chars" "0"
    fi

    # GPU
    local gpu_row
    if gpu_row=$(s9_gpu_process_for_pid "$pid" 2>/dev/null); then
        local gpu_pid gpu_process_name gpu_index gpu_name gpu_memory gpu_type gpu_scope gpu_used_total
        IFS='|' read -r gpu_pid gpu_process_name gpu_index gpu_name gpu_memory gpu_type <<< "$gpu_row"
        gpu_scope=$(s9_gpu_pid_scope "$gpu_pid" "$gpu_process_name")
        gpu_used_total=$(s9_gpu_memory_used_mb 2>/dev/null || echo 0)
        s9_json_kv "gpu_available" "true"
        s9_json_kv "gpu_pid" "$gpu_pid"
        s9_json_kv "gpu_process_name" "$gpu_process_name"
        s9_json_kv "gpu_index" "$gpu_index"
        s9_json_kv "gpu_name" "$gpu_name"
        s9_json_kv "gpu_memory_mb" "${gpu_memory:-0}"
        s9_json_kv "gpu_pid_scope" "$gpu_scope"
        s9_json_kv "gpu_memory_used_mb" "$gpu_used_total"
        s9_json_kv "gpu_process_type" "${gpu_type:-compute}" "last"
    else
        local gpu_used_total=0
        if s9_gpu_available; then
            gpu_used_total=$(s9_gpu_memory_used_mb 2>/dev/null || echo 0)
            s9_json_kv "gpu_available" "true"
        else
            s9_json_kv "gpu_available" "false"
        fi
        s9_json_kv "gpu_pid" "null"
        s9_json_kv "gpu_process_name" ""
        s9_json_kv "gpu_index" ""
        s9_json_kv "gpu_name" ""
        s9_json_kv "gpu_memory_mb" "0"
        s9_json_kv "gpu_pid_scope" ""
        s9_json_kv "gpu_process_type" ""
        if (( gpu_used_total > 100 )); then
            s9_json_kv "gpu_memory_used_mb" "$gpu_used_total"
            s9_json_kv "gpu_note" "GPU memory is in use, but nvidia-smi did not map it to this local PID; container PID isolation may be hiding the owner" "last"
        else
            s9_json_kv "gpu_memory_used_mb" "$gpu_used_total" "last"
        fi
    fi

    echo "}"
}

#------------------------------------------------------------------------------
# Main
#------------------------------------------------------------------------------

usage() {
    printf "%bs9-inspect%b - Deep process inspection tool\n" "$S9_BOLD" "$S9_NC"
    printf "Substrata9 v%s\n\n" "$S9_VERSION"

    printf "%bUSAGE:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    s9-inspect <PID|process_name> [options]\n\n"

    printf "%bOPTIONS:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    -f, --full      Include detailed memory map\n"
    printf "    -j, --json      Output in JSON format\n"
    printf "    -e, --export-json  Export JSON to an auto-named file\n"
    printf "    --export FILE   Save report to FILE (strips colors for text)\n"
    printf "    -q, --quiet     Minimal output (for scripting)\n"
    printf "    -h, --help      Show this help\n"


    printf "%bEXAMPLES:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    s9-inspect 1234           # Inspect by PID\n"
    printf "    s9-inspect nginx          # Inspect by name\n"
    printf "    s9-inspect \$\$             # Inspect current shell\n"
    printf "    s9-inspect --full \$(pgrep -f \"python app.py\")\n"
    printf "    s9-inspect --json 1234 | jq .\n"
    printf "    s9-inspect 1234 --export report.txt\n\n"

    printf "%bOUTPUT SECTIONS:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    IDENTITY    - PID, name, state, parent, user, command\n"
    printf "    MEMORY      - Virtual size, RSS, segments breakdown\n"
    printf "    FILE DESC   - Open files, sockets, pipes with targets\n"
    printf "    SIGNALS     - Blocked, ignored, caught signal masks\n"
    printf "    LIMITS      - Resource limits (ulimit values)\n"
    printf "    I/O STATS   - Read/write bytes and syscall counts\n"

    exit 0
}

run_inspection() {
    local pid=$1

    # JSON mode
    if $JSON_MODE; then
        inspect_json "$pid"
        return 0
    fi

    # Quiet mode: output key metrics only (for scripting)
    if $QUIET_MODE; then
        local rss fd_count state threads
        rss=$(s9_get_rss "$pid")
        fd_count=$(s9_get_fd_count "$pid")
        state=$(s9_get_state "$pid")
        threads=$(s9_get_threads "$pid")
        local gpu_mem=0
        local gpu_row
        if gpu_row=$(s9_gpu_process_for_pid "$pid" 2>/dev/null); then
            IFS='|' read -r _ _ _ _ gpu_mem _ <<< "$gpu_row"
        fi
        echo "PID=$pid RSS=${rss}kB FDs=$fd_count STATE=$state THREADS=$threads GPU_MEM=${gpu_mem:-0}MB"
        return 0
    fi

    local proc_name
    proc_name=$(s9_get_comm "$pid")
    s9_box_title "Substrata9 — Process Inspection Report" "Target: $proc_name (PID $pid)"

    # Run all inspections
    inspect_basic "$pid"
    inspect_memory "$pid"
    inspect_file_descriptors "$pid"
    inspect_signals "$pid"
    inspect_limits "$pid"
    inspect_io "$pid"
    inspect_gpu "$pid"

    echo ""
    s9_rule
    printf "  %bGenerated:%b %s  %b│%b  %bKernel:%b %s  %b│%b  %bSubstrata9 v%s%b\n" \
        "${S9_DIM}" "${S9_NC}" "$(date '+%Y-%m-%d %H:%M:%S')" \
        "${S9_DIM}" "${S9_NC}" \
        "${S9_DIM}" "${S9_NC}" "$(uname -r)" \
        "${S9_DIM}" "${S9_NC}" \
        "${S9_DIM}" "$S9_VERSION" "${S9_NC}"
    echo ""
}

main() {
    local target=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--full)
                SHOW_MEMORY_DETAILS=true
                shift
                ;;
            -j|--json)
                JSON_MODE=true
                shift
                ;;
            -e|--export-json)
                AUTO_EXPORT_JSON=true
                JSON_MODE=true
                shift
                ;;
            --export)
                [[ $# -ge 2 ]] || s9_die "--export requires a file path"
                EXPORT_FILE="$2"
                shift 2
                ;;
            -q|--quiet)
                QUIET_MODE=true
                shift
                ;;
            -h|--help)
                usage
                ;;

            -*)
                s9_die "Unknown option: $1. Use --help for usage."
                ;;
            *)
                [[ -z "$target" ]] || s9_die "Too many targets. Expected one PID or process name."
                target="$1"
                shift
                ;;
        esac
    done

    [[ -z "$target" ]] && usage
    if $AUTO_EXPORT_JSON && [[ -n "$EXPORT_FILE" ]]; then
        s9_die "-e cannot be combined with --export"
    fi
    if $AUTO_EXPORT_JSON && $QUIET_MODE; then
        s9_die "-e cannot be combined with --quiet"
    fi

    # Run environment checks after handling cheap flags like --help.
    s9_init

    # Resolve PID
    local pid
    pid=$(s9_resolve_pid "$target") || exit 1

    # Handle Export
    if $AUTO_EXPORT_JSON; then
        EXPORT_FILE=$(s9_auto_export_path "inspect")
    fi

    if [[ -n "$EXPORT_FILE" ]]; then
        local capture_file
        capture_file=$(mktemp) || s9_die "Cannot create temp file"

        # Run inspection and capture output
        if ! run_inspection "$pid" | tee "$capture_file"; then
            rm -f "$capture_file"
            s9_die "Failed to generate inspection report"
        fi

        # Process export file
        if $JSON_MODE; then
            cp "$capture_file" "$EXPORT_FILE" || {
                rm -f "$capture_file"
                s9_die "Cannot write export file: $EXPORT_FILE"
            }
        else
            # Strip ANSI codes for text report
            sed "s/$(printf '\033')\[[0-9;]*[a-zA-Z]//g" "$capture_file" | tr -d '\000-\011\013-\037' > "$EXPORT_FILE" || {
                rm -f "$capture_file"
                s9_die "Cannot write export file: $EXPORT_FILE"
            }
        fi

        rm -f "$capture_file"
        if $AUTO_EXPORT_JSON; then
            s9_info "JSON exported to $EXPORT_FILE" >&2
        elif $JSON_MODE; then
            s9_info "Report saved to $EXPORT_FILE" >&2
        else
            s9_info "Report saved to $EXPORT_FILE"
        fi
    else
        run_inspection "$pid"
    fi
}

main "$@"
