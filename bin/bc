#!/usr/bin/env bash
#
# bc - Minimal `bc` fallback for Substrata9
#
# This script provides a lightweight fallback for environments where the
# standard `bc` calculator is not installed. It uses awk for arithmetic.
#
# WHAT IS THIS?
# -------------
# If the system doesn't have `bc` installed, Substrata9 will automatically
# use this script instead. It handles the basic math operations used by the
# toolkit: addition, subtraction, multiplication, division, and comparisons.
#
# LIMITATIONS:
# - Only supports basic arithmetic (no advanced bc features like sqrt, sin, etc.)
# - Designed specifically for Substrata9's internal calculations
# - For full bc functionality, install the real bc: sudo apt install bc
#
# USAGE:
# This script is called internally by s9-common.sh when needed.
# You don't need to call it directly.
#
# Author: Muskula Rahul
#

set -euo pipefail

# Accept and ignore -l option (common with bc usage)
if [[ "${1:-}" == "-l" ]]; then
    shift || true
fi

# Read all stdin and normalize whitespace so the expression stays one awk
# statement after validation.
INPUT=$(tr '\n\r\t' ' ')

# Extract one leading scale assignment if present and remove it from expression.
SCALE=""
if [[ "$INPUT" =~ ^[[:space:]]*scale=([0-9]+)\;[[:space:]]*(.*)$ ]]; then
    SCALE="${BASH_REMATCH[1]}"
    INPUT="${BASH_REMATCH[2]}"
fi

# Trim whitespace
INPUT=$(printf "%s" "$INPUT" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# If empty, nothing to do
if [[ -z "$INPUT" ]]; then
    exit 0
fi

# Only accept the tiny arithmetic/comparison grammar Substrata9 uses internally.
# This keeps the fallback from becoming a general awk expression evaluator.
# Note: regex stored in variable to avoid bash parse issues with <> in [[ =~ ]].
# Allow multi-char operators like ==, !=, <=, >= with [<>=!]+
_s9_bc_pattern='^[0-9[:space:].()+*/%-]+$|^[0-9[:space:].()+*/%-]*[<>=!]+[0-9[:space:].()+*/%-]*$'
if ! [[ "$INPUT" =~ $_s9_bc_pattern ]]; then
    echo "Error: unsupported expression" >&2
    exit 1
fi

if [[ -n "$SCALE" ]]; then
    if ! [[ "$SCALE" =~ ^[0-9]+$ ]]; then
        echo "Error: invalid scale" >&2
        exit 1
    fi
    if (( SCALE > 12 )); then
        SCALE=12
    fi
fi

# Evaluate expression using awk after validation.

if [[ -n "$SCALE" ]]; then
    awk "BEGIN { res = ($INPUT); printf \"%.*f\n\", ${SCALE}, res }"
else
    # Without scale, mimic real bc: integer division (truncate toward zero)
    awk "BEGIN { res = ($INPUT); print int(res) }"
fi
