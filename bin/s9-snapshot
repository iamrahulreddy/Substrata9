#!/usr/bin/env bash
#
# s9-snapshot - Process state capture and comparison
# Substrata9
#
# Author: Muskula Rahul
#
# Requirements: bash 4.0+, Linux with /proc filesystem
#

# Note: Using set -uo pipefail (without -e) to handle race conditions
# when processes exit during snapshot capture

set -uo pipefail

#------------------------------------------------------------------------------
# Source Common Library
#------------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/s9-common.sh
source "${SCRIPT_DIR}/../lib/s9-common.sh" 2>/dev/null || \
source "${SCRIPT_DIR}/../lib/substrata9/s9-common.sh" 2>/dev/null || \
source "/usr/local/lib/substrata9/s9-common.sh" 2>/dev/null || \
{ echo "Error: Cannot find s9-common.sh library"; exit 1; }

#------------------------------------------------------------------------------
# Configuration
#------------------------------------------------------------------------------
SNAPSHOT_DIR=""
JSON_MODE=false
AUTO_EXPORT_JSON=false
S9_RESOLVED_SNAPSHOT=""
declare -a S9_SNAPSHOT_MATCHES=()
declare -a S9_DELETE_SNAPSHOTS=()

#------------------------------------------------------------------------------
# Snapshot Functions
#------------------------------------------------------------------------------

resolve_snapshot_dir() {
    if [[ -z "${HOME:-}" ]] && [[ -z "${S9_SNAPSHOT_DIR:-}" ]]; then
        s9_die "HOME is not set; set S9_SNAPSHOT_DIR to choose a snapshot directory"
    fi

    SNAPSHOT_DIR="${S9_SNAPSHOT_DIR:-${HOME}/.substrata9/snapshots}"

    # Security: Validate user-provided directory is in a safe location.
    if [[ -n "${S9_SNAPSHOT_DIR:-}" ]]; then
        s9_validate_safe_dir "$SNAPSHOT_DIR" || s9_die "Unsafe snapshot directory: $SNAPSHOT_DIR"
    fi
}

ensure_snapshot_dir() {
    resolve_snapshot_dir
    local existed=false
    [[ -d "$SNAPSHOT_DIR" ]] && existed=true

    mkdir -p "$SNAPSHOT_DIR" || s9_die "Cannot create snapshot directory: $SNAPSHOT_DIR"

    # Do not chmod pre-existing custom directories such as /tmp.
    if ! $existed || [[ -z "${S9_SNAPSHOT_DIR:-}" ]]; then
        chmod 700 "$SNAPSHOT_DIR" 2>/dev/null || true
    fi
}

collect_snapshot_matches() {
    local ref="$1"
    S9_SNAPSHOT_MATCHES=()

    if [[ "$ref" == */* ]] || [[ "$ref" == *\\* ]]; then
        s9_die "Snapshot reference must be a snapshot name or basename, not a path"
    fi
    if ! [[ "$ref" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
        s9_die "Invalid snapshot reference: $ref"
    fi

    if [[ "$ref" == *.snap && -f "$SNAPSHOT_DIR/$ref" ]]; then
        S9_SNAPSHOT_MATCHES+=( "$SNAPSHOT_DIR/$ref" )
        return 0
    fi
    [[ "$ref" == *.snap ]] && return 0

    local snap restore_nullglob=false
    if ! shopt -q nullglob; then
        restore_nullglob=true
        shopt -s nullglob
    fi
    for snap in "$SNAPSHOT_DIR/${ref}"_*.snap; do
        S9_SNAPSHOT_MATCHES+=( "$snap" )
    done
    $restore_nullglob && shopt -u nullglob
}

latest_snapshot_from_list() {
    local latest="$1"
    shift

    local snap
    for snap in "$@"; do
        if [[ "$snap" -nt "$latest" ]]; then
            latest="$snap"
        fi
    done

    printf "%s\n" "$latest"
}

resolve_snapshot_ref() {
    local ref="$1"
    local allow_latest="${2:-false}"
    S9_RESOLVED_SNAPSHOT=""

    collect_snapshot_matches "$ref"

    if (( ${#S9_SNAPSHOT_MATCHES[@]} == 0 )); then
        s9_die "Snapshot '$ref' not found"
    fi

    if (( ${#S9_SNAPSHOT_MATCHES[@]} == 1 )); then
        S9_RESOLVED_SNAPSHOT="${S9_SNAPSHOT_MATCHES[0]}"
        return 0
    fi

    if [[ "$allow_latest" == "true" ]]; then
        S9_RESOLVED_SNAPSHOT=$(latest_snapshot_from_list "${S9_SNAPSHOT_MATCHES[@]}")
        return 0
    fi

    s9_warn "Multiple snapshots match '$ref':"
    local snap
    for snap in "${S9_SNAPSHOT_MATCHES[@]}"; do
        printf "  %s\n" "$(basename "$snap")" >&2
    done
    s9_die "Use an exact .snap basename or pass --latest"
}

resolve_snapshot_delete_set() {
    local ref="$1"
    local mode="${2:-single}"
    S9_DELETE_SNAPSHOTS=()

    collect_snapshot_matches "$ref"

    if (( ${#S9_SNAPSHOT_MATCHES[@]} == 0 )); then
        s9_die "Snapshot '$ref' not found"
    fi

    if [[ "$mode" == "all" ]]; then
        S9_DELETE_SNAPSHOTS=( "${S9_SNAPSHOT_MATCHES[@]}" )
        return 0
    fi

    if (( ${#S9_SNAPSHOT_MATCHES[@]} == 1 )); then
        S9_DELETE_SNAPSHOTS=( "${S9_SNAPSHOT_MATCHES[0]}" )
        return 0
    fi

    if [[ "$mode" == "latest" ]]; then
        S9_DELETE_SNAPSHOTS=( "$(latest_snapshot_from_list "${S9_SNAPSHOT_MATCHES[@]}")" )
        return 0
    fi

    s9_warn "Multiple snapshots match '$ref':"
    local snap
    for snap in "${S9_SNAPSHOT_MATCHES[@]}"; do
        printf "  %s\n" "$(basename "$snap")" >&2
    done
    s9_die "Use an exact .snap basename, --latest, or --all"
}

capture_snapshot() {
    local pid=$1
    local snap_name=$2

    # Validate PID is numeric
    [[ "$pid" =~ ^[0-9]+$ ]] || s9_die "PID must be a number"
    [[ -d "/proc/$pid" ]] || s9_die "Process $pid does not exist"

    # Sanitize snapshot name to prevent path injection
    local safe_name="${snap_name//[^a-zA-Z0-9_-]/}"
    if [[ "$safe_name" != "$snap_name" ]]; then
        s9_warn "Snapshot name sanitized to: $safe_name"
        snap_name="$safe_name"
    fi
    [[ -n "$snap_name" ]] || s9_die "Snapshot name cannot be empty after sanitization"

    # Validate snapshot name length (max 64 characters)
    if (( ${#snap_name} > 64 )); then
        s9_die "Snapshot name too long (max 64 characters, got ${#snap_name})"
    fi

    local timestamp
    timestamp=$(date '+%Y%m%d_%H%M%S')
    local snap_file
    snap_file=$(mktemp "$SNAPSHOT_DIR/${snap_name}_${pid}_${timestamp}_XXXXXX.snap") || \
        s9_die "Cannot create snapshot file in $SNAPSHOT_DIR"

    if ! $JSON_MODE; then
        s9_info "Capturing snapshot of PID $pid..."
    fi

    {
        echo "# Substrata9 Process Snapshot"
        echo "# Version: $S9_VERSION"
        echo "# PID: $pid"
        echo "# Name: $snap_name"
        echo "# Timestamp: $(date '+%Y-%m-%d %H:%M:%S')"
        echo "# Kernel: $(uname -r)"
        echo ""

        echo "[STATUS]"
        cat "/proc/$pid/status" 2>/dev/null || echo "ERROR: Cannot read status"
        echo ""

        echo "[STAT]"
        cat "/proc/$pid/stat" 2>/dev/null || echo "ERROR: Cannot read stat"
        echo ""

        echo "[CMDLINE]"
        tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || echo "ERROR: Cannot read cmdline"
        echo -e "\n"

        echo "[FD_COUNT]"
        if [[ -r "/proc/$pid/fd" ]]; then
            ls -1 -- "/proc/$pid/fd" 2>/dev/null | wc -l
        else
            echo "0"
        fi
        echo ""

        echo "[FD_LIST]"
        if [[ -r "/proc/$pid/fd" ]]; then
            for fd in /proc/$pid/fd/*; do
                [[ -e "$fd" ]] || continue
                local fd_num="${fd##*/}"
                local target
                target=$(readlink "$fd" 2>/dev/null || echo "unknown")
                echo "$fd_num -> $target"
            done
        else
            echo "ERROR: Cannot read fd directory"
        fi
        echo ""

        echo "[LIMITS]"
        cat "/proc/$pid/limits" 2>/dev/null || echo "ERROR: Cannot read limits"
        echo ""

        echo "[IO]"
        cat "/proc/$pid/io" 2>/dev/null || echo "ERROR: Cannot read I/O stats (requires root)"
        echo ""

        echo "[MAPS_SUMMARY]"
        if [[ -r "/proc/$pid/maps" ]]; then
            echo "Regions: $(wc -l < "/proc/$pid/maps")"
            echo "Heap: $(grep '\[heap\]' "/proc/$pid/maps" 2>/dev/null || echo 'N/A')"
            echo "Stack: $(grep '\[stack\]' "/proc/$pid/maps" 2>/dev/null || echo 'N/A')"
        else
            echo "ERROR: Cannot read maps"
        fi

    } > "$snap_file" || s9_die "Cannot write snapshot file: $snap_file"

    if $JSON_MODE; then
        echo "{"
        s9_json_kv "status" "success"
        s9_json_kv "file" "$snap_file"
        s9_json_kv "name" "$snap_name"
        s9_json_kv "pid" "$pid"
        s9_json_kv "timestamp" "$(date '+%Y-%m-%d %H:%M:%S')" "last"
        echo "}"
    else
        s9_success "Snapshot saved: $snap_file"
        echo "  Name: $snap_name"
        echo "  PID: $pid ($(s9_get_comm "$pid"))"
        echo "  Time: $(date '+%Y-%m-%d %H:%M:%S')"
        echo "  Size: $(du -h "$snap_file" | cut -f1)"
    fi
}

list_snapshots() {
    if $JSON_MODE; then
        echo "{"
        echo "  \"snapshots\": ["
    else
        printf "%bAvailable Snapshots:%b\n" "${S9_BOLD}" "${S9_NC}"
        echo ""
    fi

    if [[ ! -d "$SNAPSHOT_DIR" ]] || [[ -z "$(ls -A "$SNAPSHOT_DIR" 2>/dev/null)" ]]; then
        if $JSON_MODE; then
            echo "  ]"
            echo "}"
        else
            printf "  %bNo snapshots found in %s%b\n" "${S9_DIM}" "$SNAPSHOT_DIR" "${S9_NC}"
            echo ""
            echo "  Create one with: s9-snapshot capture <PID> --name <name>"
        fi
        return
    fi

    if ! $JSON_MODE; then
        printf "  ${S9_BOLD}%-20s %-8s %-20s %-10s${S9_NC}\n" "NAME" "PID" "TIMESTAMP" "SIZE"
        printf "  ${S9_DIM}─────────────────────────────────────────────────────────────────────${S9_NC}\n"
    fi

    local first=true

    for snap in "$SNAPSHOT_DIR"/*.snap; do
        [[ -f "$snap" ]] || continue

        local basename="${snap##*/}"
        # Parse filename: name_pid_YYYYMMDD_HHMMSS[_unique].snap
        local name pid timestamp

        # Remove .snap extension
        local noext="${basename%.snap}"

        if [[ "$noext" =~ ^(.+)_([0-9]+)_([0-9]{8})_([0-9]{6})(_[A-Za-z0-9]+)?$ ]]; then
            name="${BASH_REMATCH[1]}"
            pid="${BASH_REMATCH[2]}"
            timestamp="${BASH_REMATCH[3]}_${BASH_REMATCH[4]}"
        else
            name="$noext"
            pid="?"
            timestamp=""
        fi

        # Format timestamp (YYYYMMDD_HHMMSS -> YYYY-MM-DD HH:MM)
        local formatted=""
        if [[ "$timestamp" =~ ^[0-9]{8}_[0-9]{6}$ ]]; then
            local year=${timestamp:0:4}
            local month=${timestamp:4:2}
            local day=${timestamp:6:2}
            local hour=${timestamp:9:2}
            local min=${timestamp:11:2}
            formatted="$year-$month-$day $hour:$min"
        else
            formatted="$timestamp"
        fi

        local size
        size=$(du -h "$snap" | cut -f1)

        if $JSON_MODE; then
            if $first; then first=false; else echo ","; fi
            echo "    {"
            s9_json_kv "name" "$name" "" "    "
            s9_json_kv "pid" "$pid" "" "    "
            s9_json_kv "timestamp" "$formatted" "" "    "
            s9_json_kv "size" "$size" "" "    "
            s9_json_kv "file" "$snap" "last" "    "
            echo -n "    }"
        else
            printf "  %-20s ${S9_CYAN}%-8s${S9_NC} %-20s ${S9_DIM}%-10s${S9_NC}\n" \
                "${name:0:20}" "$pid" "$formatted" "$size"
        fi
    done

    if $JSON_MODE; then
        echo ""
        echo "  ]"
        echo "}"
    else
        echo ""
        printf "%bSnapshot directory: %s%b\n" "${S9_DIM}" "$SNAPSHOT_DIR" "${S9_NC}"
    fi
}

diff_snapshots() {
    local snap1_name=$1
    local snap2_name=$2
    local use_latest="${3:-false}"

    [[ -n "$snap1_name" ]] || s9_die "Invalid snapshot name"
    [[ -n "$snap2_name" ]] || s9_die "Invalid snapshot name"

    # Resolve references. Plain names must be unambiguous unless --latest is used.
    local snap1 snap2
    resolve_snapshot_ref "$snap1_name" "$use_latest"
    snap1="$S9_RESOLVED_SNAPSHOT"
    resolve_snapshot_ref "$snap2_name" "$use_latest"
    snap2="$S9_RESOLVED_SNAPSHOT"

    # Validate snapshot format
    grep -q "^# Substrata9 Process Snapshot" "$snap1" || s9_die "Invalid snapshot format: $snap1"
    grep -q "^# Substrata9 Process Snapshot" "$snap2" || s9_die "Invalid snapshot format: $snap2"

    # Extract metadata
    local time1 time2 pid1 pid2 name1 name2
    time1=$(grep "^# Timestamp:" "$snap1" | cut -d: -f2- | xargs)
    time2=$(grep "^# Timestamp:" "$snap2" | cut -d: -f2- | xargs)
    pid1=$(grep "^# PID:" "$snap1" | awk '{print $3}')
    pid2=$(grep "^# PID:" "$snap2" | awk '{print $3}')
    name1=$(grep "^# Name:" "$snap1" | cut -d: -f2 | xargs)
    name2=$(grep "^# Name:" "$snap2" | cut -d: -f2 | xargs)

    # Get process names from snapshot status section
    local proc_name1 proc_name2
    proc_name1=$(grep "^Name:" "$snap1" 2>/dev/null | head -1 | awk '{print $2}' || echo "unknown")
    proc_name2=$(grep "^Name:" "$snap2" 2>/dev/null | head -1 | awk '{print $2}' || echo "unknown")

    if $JSON_MODE; then
        echo "{"
        s9_json_kv "before" "$(basename "$snap1")"
        s9_json_kv "after" "$(basename "$snap2")"
        s9_json_kv "pid1" "$pid1"
        s9_json_kv "pid2" "$pid2"
    else
        s9_box_title "Substrata9 — Process Comparison" "Analyzing resource differences between snapshots"

        echo ""
        printf "  ${S9_BOLD}%-12s${S9_NC} %s (%s) — %bPID %s%b\n" "Before:" "$name1" "$proc_name1" "${S9_CYAN}" "$pid1" "${S9_NC}"
        printf "  ${S9_BOLD}%-12s${S9_NC} %s (%s) — %bPID %s%b\n" "After:" "$name2" "$proc_name2" "${S9_CYAN}" "$pid2" "${S9_NC}"
        printf "  ${S9_DIM}Time span:   %s → %s${S9_NC}\n" "$time1" "$time2"
    fi

    # =========================================================================
    # MEMORY COMPARISON
    # =========================================================================
    local rss1 rss2 vmsize1 vmsize2 vmswap1 vmswap2 vmpeak1 vmpeak2
    rss1=$(grep "^VmRSS:" "$snap1" 2>/dev/null | awk '{print $2}' || echo "0")
    rss2=$(grep "^VmRSS:" "$snap2" 2>/dev/null | awk '{print $2}' || echo "0")
    vmsize1=$(grep "^VmSize:" "$snap1" 2>/dev/null | awk '{print $2}' || echo "0")
    vmsize2=$(grep "^VmSize:" "$snap2" 2>/dev/null | awk '{print $2}' || echo "0")
    vmswap1=$(grep "^VmSwap:" "$snap1" 2>/dev/null | awk '{print $2}' || echo "0")
    vmswap2=$(grep "^VmSwap:" "$snap2" 2>/dev/null | awk '{print $2}' || echo "0")
    vmpeak1=$(grep "^VmPeak:" "$snap1" 2>/dev/null | awk '{print $2}' || echo "0")
    vmpeak2=$(grep "^VmPeak:" "$snap2" 2>/dev/null | awk '{print $2}' || echo "0")

    # Ensure numeric
    [[ "$rss1" =~ ^[0-9]+$ ]] || rss1=0
    [[ "$rss2" =~ ^[0-9]+$ ]] || rss2=0
    [[ "$vmsize1" =~ ^[0-9]+$ ]] || vmsize1=0
    [[ "$vmsize2" =~ ^[0-9]+$ ]] || vmsize2=0
    [[ "$vmswap1" =~ ^[0-9]+$ ]] || vmswap1=0
    [[ "$vmswap2" =~ ^[0-9]+$ ]] || vmswap2=0
    [[ "$vmpeak1" =~ ^[0-9]+$ ]] || vmpeak1=0
    [[ "$vmpeak2" =~ ^[0-9]+$ ]] || vmpeak2=0

    if $JSON_MODE; then
        echo "  \"memory\": {"
        s9_json_kv "rss_before_kb" "$rss1"
        s9_json_kv "rss_after_kb" "$rss2"
        s9_json_kv "rss_diff_kb" "$((rss2 - rss1))"
        s9_json_kv "vmsize_before_kb" "$vmsize1"
        s9_json_kv "vmsize_after_kb" "$vmsize2"
        s9_json_kv "vmsize_diff_kb" "$((vmsize2 - vmsize1))"
        s9_json_kv "vmswap_before_kb" "$vmswap1"
        s9_json_kv "vmswap_after_kb" "$vmswap2" "last"
        echo "  },"
    else
        s9_header "MEMORY COMPARISON"
        s9_compare_header "Before" "After"
        s9_compare_row "RSS" "$rss1" "$rss2" "kB" "kb"
        s9_compare_row "Virtual Size" "$vmsize1" "$vmsize2" "kB" "kb"
        s9_compare_row "Peak Virtual" "$vmpeak1" "$vmpeak2" "kB" "kb"
        s9_compare_row "Swap" "$vmswap1" "$vmswap2" "kB" "kb"
    fi

    # =========================================================================
    # FILE DESCRIPTOR COMPARISON
    # =========================================================================
    local fd1 fd2
    fd1=$(grep -A1 "\[FD_COUNT\]" "$snap1" | tail -1 | tr -d '[:space:]')
    fd2=$(grep -A1 "\[FD_COUNT\]" "$snap2" | tail -1 | tr -d '[:space:]')

    [[ "$fd1" =~ ^[0-9]+$ ]] || fd1=0
    [[ "$fd2" =~ ^[0-9]+$ ]] || fd2=0

    # =========================================================================
    # THREAD COMPARISON
    # =========================================================================
    local threads1 threads2
    threads1=$(grep "^Threads:" "$snap1" 2>/dev/null | awk '{print $2}' || echo "0")
    threads2=$(grep "^Threads:" "$snap2" 2>/dev/null | awk '{print $2}' || echo "0")

    [[ "$threads1" =~ ^[0-9]+$ ]] || threads1=0
    [[ "$threads2" =~ ^[0-9]+$ ]] || threads2=0

    if $JSON_MODE; then
        echo "  \"resources\": {"
        s9_json_kv "fd_before" "$fd1"
        s9_json_kv "fd_after" "$fd2"
        s9_json_kv "fd_diff" "$((fd2 - fd1))"
        s9_json_kv "threads_before" "$threads1"
        s9_json_kv "threads_after" "$threads2"
        s9_json_kv "threads_diff" "$((threads2 - threads1))" "last"
        echo "  },"
    else
        s9_header "RESOURCE COMPARISON"
        s9_compare_header "Before" "After"
        s9_compare_row "Open FDs" "$fd1" "$fd2" ""
        s9_compare_row "Threads" "$threads1" "$threads2" ""
    fi

    # =========================================================================
    # I/O COMPARISON (if available)
    # =========================================================================
    local rbytes1 rbytes2 wbytes1 wbytes2
    rbytes1=$(grep "^read_bytes:" "$snap1" 2>/dev/null | awk '{print $2}' || echo "")
    rbytes2=$(grep "^read_bytes:" "$snap2" 2>/dev/null | awk '{print $2}' || echo "")
    wbytes1=$(grep "^write_bytes:" "$snap1" 2>/dev/null | awk '{print $2}' || echo "")
    wbytes2=$(grep "^write_bytes:" "$snap2" 2>/dev/null | awk '{print $2}' || echo "")

    if [[ -n "$rbytes1" ]] && [[ -n "$rbytes2" ]]; then
        [[ "$rbytes1" =~ ^[0-9]+$ ]] || rbytes1=0
        [[ "$rbytes2" =~ ^[0-9]+$ ]] || rbytes2=0
        [[ "$wbytes1" =~ ^[0-9]+$ ]] || wbytes1=0
        [[ "$wbytes2" =~ ^[0-9]+$ ]] || wbytes2=0

        if $JSON_MODE; then
            echo "  \"io\": {"
            s9_json_kv "read_before" "$rbytes1"
            s9_json_kv "read_after" "$rbytes2"
            s9_json_kv "read_diff" "$((rbytes2 - rbytes1))"
            s9_json_kv "write_before" "$wbytes1"
            s9_json_kv "write_after" "$wbytes2"
            s9_json_kv "write_diff" "$((wbytes2 - wbytes1))" "last"
            echo "  },"
        else
            s9_header "I/O COMPARISON"
            s9_compare_header "Before" "After"
            s9_compare_row "Disk Read" "$rbytes1" "$rbytes2" "bytes" "bytes"
            s9_compare_row "Disk Write" "$wbytes1" "$wbytes2" "bytes" "bytes"
        fi
    fi

    # =========================================================================
    # ASSESSMENT
    # =========================================================================
    local rss_diff=$((rss2 - rss1))
    local fd_diff=$((fd2 - fd1))
    local threads_diff=$((threads2 - threads1))
    local swap_diff=$((vmswap2 - vmswap1))

    if $JSON_MODE; then
        echo "  \"assessment\": {"
        local mem_status="stable"
        if (( rss_diff > 100000 )); then mem_status="critical_growth";
        elif (( rss_diff > 10000 )); then mem_status="moderate_growth";
        elif (( rss_diff < -10000 )); then mem_status="significant_decrease"; fi

        local fd_status="stable"
        if (( fd_diff > 100 )); then fd_status="critical_growth";
        elif (( fd_diff > 10 )); then fd_status="moderate_growth"; fi

        local threads_status="stable"
        if (( threads_diff > 10 )); then threads_status="significant_change"; fi

        s9_json_kv "memory_status" "$mem_status"
        s9_json_kv "fd_status" "$fd_status"
        s9_json_kv "threads_status" "$threads_status"
        s9_json_kv "rss_diff_kb" "$rss_diff"
        s9_json_kv "fd_diff" "$fd_diff"
        s9_json_kv "threads_diff" "$threads_diff" "last"
        echo "  }"
        echo "}"
    else
        s9_header "ASSESSMENT"

        local issues_found=0

        # Memory assessment
        if (( rss_diff > 100000 )); then
            printf "  ${S9_RED}⚠ CRITICAL:${S9_NC} Significant memory growth detected (${S9_RED}+%s${S9_NC})\n" "$(s9_human_kb "$rss_diff")"
            printf "    ${S9_DIM}This could indicate a memory leak. Monitor closely.${S9_NC}\n"
            ((issues_found++))
        elif (( rss_diff > 10000 )); then
            printf "  ${S9_YELLOW}⚡ WARNING:${S9_NC} Moderate memory growth (${S9_YELLOW}+%s${S9_NC})\n" "$(s9_human_kb "$rss_diff")"
            ((issues_found++))
        elif (( rss_diff < -10000 )); then
            printf "  ${S9_GREEN}✓${S9_NC} Memory decreased by %s (good)\n" "$(s9_human_kb "${rss_diff#-}")"
        else
            printf "  ${S9_GREEN}✓${S9_NC} Memory usage is stable\n"
        fi

        # Swap assessment
        if (( swap_diff > 0 )); then
            printf "  ${S9_YELLOW}⚡ WARNING:${S9_NC} Swap usage increased by ${S9_YELLOW}%s${S9_NC}\n" "$(s9_human_kb "$swap_diff")"
            printf "    ${S9_DIM}Process may be under memory pressure.${S9_NC}\n"
            ((issues_found++))
        fi

        # FD assessment
        if (( fd_diff > 100 )); then
            printf "  ${S9_RED}⚠ CRITICAL:${S9_NC} Large FD growth detected (${S9_RED}+%d${S9_NC})\n" "$fd_diff"
            printf "    ${S9_DIM}Possible file descriptor leak. Check for unclosed files/sockets.${S9_NC}\n"
            ((issues_found++))
        elif (( fd_diff > 10 )); then
            printf "  ${S9_YELLOW}⚡ WARNING:${S9_NC} FD count increased by ${S9_YELLOW}%d${S9_NC}\n" "$fd_diff"
            ((issues_found++))
        elif (( fd_diff < -10 )); then
            printf "  ${S9_GREEN}✓${S9_NC} FD count decreased by %d\n" "${fd_diff#-}"
        else
            printf "  ${S9_GREEN}✓${S9_NC} File descriptor count is stable\n"
        fi

        # Thread assessment
        if (( threads_diff > 10 )); then
            printf "  ${S9_YELLOW}⚡ Note:${S9_NC} Thread count increased significantly (${S9_YELLOW}+%d${S9_NC})\n" "$threads_diff"
            ((issues_found++))
        elif (( threads_diff < -5 )); then
            printf "  ${S9_CYAN}●${S9_NC} Thread count decreased by %d\n" "${threads_diff#-}"
        else
            printf "  ${S9_GREEN}✓${S9_NC} Thread count is stable\n"
        fi

        # Summary
        echo ""
        if (( issues_found == 0 )); then
            printf "  ${S9_GREEN}${S9_BOLD}Overall: No significant issues detected${S9_NC}\n"
        else
            printf "  ${S9_YELLOW}${S9_BOLD}Overall: %d potential issue(s) detected${S9_NC}\n" "$issues_found"
        fi

        # Footer
        echo ""
        s9_rule
        printf "  ${S9_DIM}Generated: %s  │  Kernel: %s  │  Substrata9 v%s${S9_NC}\n" \
            "$(date '+%Y-%m-%d %H:%M:%S')" "$(uname -r)" "$S9_VERSION"
        echo ""
    fi
}

delete_snapshot() {
    local snap_name=$1
    local force_delete=${2:-false}
    local delete_mode="${3:-single}"

    [[ -n "$snap_name" ]] || s9_die "Invalid snapshot name"

    local -a snaps=()
    resolve_snapshot_delete_set "$snap_name" "$delete_mode"
    snaps=( "${S9_DELETE_SNAPSHOTS[@]}" )

    local count
    count=${#snaps[@]}

    # Skip confirmation in JSON mode or when --force is used
    if $JSON_MODE || $force_delete; then
        rm -f -- "${snaps[@]}"
        if $JSON_MODE; then
            echo "{"
            s9_json_kv "status" "deleted"
            s9_json_kv "count" "$count" "last"
            echo "}"
        else
            s9_success "Deleted $count snapshot(s)"
        fi
        return
    fi

    echo "Found $count snapshot(s) matching '$snap_name':"
    local f
    for f in "${snaps[@]}"; do
        echo "  $(basename "$f")"
    done
    echo ""

    read -p "Delete these snapshots? [y/N] " -n 1 -r
    echo

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        rm -f -- "${snaps[@]}"
        s9_success "Deleted $count snapshot(s)"
    else
        echo "Cancelled"
    fi
}

#------------------------------------------------------------------------------
# Main
#------------------------------------------------------------------------------

usage() {
    printf "%bs9-snapshot%b - Process state capture and comparison\n" "$S9_BOLD" "$S9_NC"
    printf "Substrata9 v%s\n\n" "$S9_VERSION"

    printf "%bUSAGE:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    s9-snapshot capture <PID> --name <name>\n"
    printf "    s9-snapshot list\n"
    printf "    s9-snapshot diff <name1|file.snap> <name2|file.snap> [--latest]\n"
    printf "    s9-snapshot delete <name|file.snap> [--latest|--all] [--force]\n\n"

    printf "%bCOMMANDS:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    capture    Capture process state snapshot\n"
    printf "    list       List all saved snapshots\n"
    printf "    diff       Compare two snapshots\n"
    printf "    delete     Delete snapshots by name\n\n"

    printf "%bOPTIONS:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    --name NAME    Name for the snapshot (required for capture)\n"
    printf "    --force, -y    Skip confirmation prompt (for delete)\n"
    printf "    --latest      Use/delete newest match when a snapshot name is ambiguous\n"
    printf "    --all         Delete all snapshots matching a name\n"
    printf "    -j, --json     Output in JSON format (for list, diff, capture result)\n"
    printf "    -e, --export-json  Export JSON to an auto-named file\n"
    printf "    -h, --help     Show this help\n"


    printf "%bEXAMPLES:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    # Capture before and after states\n"
    printf "    s9-snapshot capture \$(pgrep -n -x myapp) --name before_test\n"
    printf "    # ... run test ...\n"
    printf "    s9-snapshot capture \$(pgrep -n -x myapp) --name after_test\n"
    printf "\n"
    printf "    # Compare the snapshots\n"
    printf "    s9-snapshot diff before_test after_test --latest\n"
    printf "\n"
    printf "    # List all snapshots\n"
    printf "    s9-snapshot list\n"
    printf "\n"
    printf "    # Clean up the newest matching snapshot without prompting\n"
    printf "    s9-snapshot delete before_test --latest --force\n\n"

    printf "%bENVIRONMENT:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    S9_SNAPSHOT_DIR    Override snapshot directory (default: ~/.substrata9/snapshots)\n"

    exit 0
}

main() {
    [[ $# -eq 0 ]] && usage

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -j|--json)
                JSON_MODE=true
                shift
                ;;
            -e|--export-json)
                AUTO_EXPORT_JSON=true
                JSON_MODE=true
                shift
                ;;
            -h|--help)
                usage
                ;;
            --)
                shift
                break
                ;;
            *)
                break
                ;;
        esac
    done

    [[ $# -gt 0 ]] || usage
    local command="$1"
    shift

    case "$command" in
        capture)
            local pid=""
            local snap_name=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -j|--json)
                        JSON_MODE=true
                        shift
                        ;;
                    -e|--export-json)
                        AUTO_EXPORT_JSON=true
                        JSON_MODE=true
                        shift
                        ;;
                    --name|-n)
                        [[ $# -ge 2 ]] || s9_die "--name requires a snapshot name"
                        snap_name="$2"
                        shift 2
                        ;;
                    -h|--help)
                        usage
                        ;;
                    -*)
                        s9_die "Unknown option: $1"
                        ;;
                    *)
                        [[ -z "$pid" ]] || s9_die "Too many arguments. Expected one PID."
                        pid="$1"
                        shift
                        ;;
                esac
            done

            [[ -n "$pid" ]] || s9_die "Usage: s9-snapshot capture <PID> --name <name>"
            [[ -n "$snap_name" ]] || s9_die "Snapshot name required (--name)"
            s9_init
            ensure_snapshot_dir
            if $AUTO_EXPORT_JSON; then
                local export_file
                export_file=$(s9_auto_export_path "snapshot-capture")
                s9_export_json_output "$export_file" capture_snapshot "$pid" "$snap_name"
            else
                capture_snapshot "$pid" "$snap_name"
            fi
            ;;
        list)
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -j|--json)
                        JSON_MODE=true
                        shift
                        ;;
                    -e|--export-json)
                        AUTO_EXPORT_JSON=true
                        JSON_MODE=true
                        shift
                        ;;
                    -h|--help)
                        usage
                        ;;
                    *)
                        s9_die "Unknown option: $1"
                        ;;
                esac
            done

            s9_init
            resolve_snapshot_dir
            if $AUTO_EXPORT_JSON; then
                local export_file
                export_file=$(s9_auto_export_path "snapshot-list")
                s9_export_json_output "$export_file" list_snapshots
            else
                list_snapshots
            fi
            ;;
        diff)
            local -a diff_names=()
            local diff_latest=false
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -j|--json)
                        JSON_MODE=true
                        shift
                        ;;
                    -e|--export-json)
                        AUTO_EXPORT_JSON=true
                        JSON_MODE=true
                        shift
                        ;;
                    -h|--help)
                        usage
                        ;;
                    --latest)
                        diff_latest=true
                        shift
                        ;;
                    -*)
                        s9_die "Unknown option: $1"
                        ;;
                    *)
                        diff_names+=("$1")
                        shift
                        ;;
                esac
            done

            [[ ${#diff_names[@]} -eq 2 ]] || s9_die "Usage: s9-snapshot diff <name1|file.snap> <name2|file.snap> [--latest]"
            s9_init
            resolve_snapshot_dir
            if $AUTO_EXPORT_JSON; then
                local export_file
                export_file=$(s9_auto_export_path "snapshot-diff")
                s9_export_json_output "$export_file" diff_snapshots "${diff_names[0]}" "${diff_names[1]}" "$diff_latest"
            else
                diff_snapshots "${diff_names[0]}" "${diff_names[1]}" "$diff_latest"
            fi
            ;;
        delete|rm)
            local del_name=""
            local force_flag=false
            local delete_mode="single"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -j|--json)
                        JSON_MODE=true
                        shift
                        ;;
                    -e|--export-json)
                        AUTO_EXPORT_JSON=true
                        JSON_MODE=true
                        shift
                        ;;
                    --force|-y)
                        force_flag=true
                        shift
                        ;;
                    --latest)
                        [[ "$delete_mode" == "all" ]] && s9_die "--latest cannot be combined with --all"
                        delete_mode="latest"
                        shift
                        ;;
                    --all)
                        [[ "$delete_mode" == "latest" ]] && s9_die "--all cannot be combined with --latest"
                        delete_mode="all"
                        shift
                        ;;
                    -h|--help)
                        usage
                        ;;
                    -*)
                        s9_die "Unknown option: $1"
                        ;;
                    *)
                        [[ -z "$del_name" ]] || s9_die "Too many arguments. Expected one snapshot name."
                        del_name="$1"
                        shift
                        ;;
                esac
            done
            [[ -n "$del_name" ]] || s9_die "Usage: s9-snapshot delete <name|file.snap> [--latest|--all] [--force]"

            s9_init
            resolve_snapshot_dir
            if $AUTO_EXPORT_JSON; then
                local export_file
                export_file=$(s9_auto_export_path "snapshot-delete")
                s9_export_json_output "$export_file" delete_snapshot "$del_name" "$force_flag" "$delete_mode"
            else
                delete_snapshot "$del_name" "$force_flag" "$delete_mode"
            fi
            ;;

        *)
            s9_die "Unknown command: $command. Use --help for usage."
            ;;
    esac
}

main "$@"
