#!/usr/bin/env bash
#
# s9-fdmap - File descriptor mapping across processes
# Substrata9
#
# Author: Muskula Rahul
#
# Requirements: bash 4.0+, Linux with /proc filesystem
#

# Note: Using set -uo pipefail (without -e) to handle race conditions
# when processes exit during /proc scanning

set -uo pipefail

#------------------------------------------------------------------------------
# Source Common Library
#------------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/s9-common.sh
source "${SCRIPT_DIR}/../lib/s9-common.sh" 2>/dev/null || \
source "${SCRIPT_DIR}/../lib/substrata9/s9-common.sh" 2>/dev/null || \
source "/usr/local/lib/substrata9/s9-common.sh" 2>/dev/null || \
{ echo "Error: Cannot find s9-common.sh library"; exit 1; }

#------------------------------------------------------------------------------
# Configuration
#------------------------------------------------------------------------------
SEARCH_FILE=""
SEARCH_SOCKET=""
FIND_LEAKS=false
LEAK_THRESHOLD=100
TOP_N=20
QUIET_MODE=false
JSON_MODE=false
AUTO_EXPORT_JSON=false

declare -A SOCKET_INDEX=()
declare -A SOCKET_MATCHES=()
SOCKET_FOUND=0
SOCKET_FIRST=true
S9_FDMAP_TMP_FILE=""

_s9_fdmap_cleanup() {
    [[ -n "${S9_FDMAP_TMP_FILE:-}" ]] && rm -f -- "$S9_FDMAP_TMP_FILE"
}

#------------------------------------------------------------------------------
# FD Analysis Functions
#------------------------------------------------------------------------------

system_summary() {
    if $JSON_MODE; then
        echo "{"
        echo "  \"summary\": ["
    else
        s9_box_title "Substrata9 — File Descriptor Summary" "System-wide FD analysis"

        printf "  %bScanning processes...%b\n" "${S9_DIM}" "${S9_NC}"
        echo ""
    fi

    # Use temp file for streaming sort (handles large process counts)
    local tmp_file
    tmp_file=$(mktemp) || s9_die "Cannot create temp file"

    S9_FDMAP_TMP_FILE="$tmp_file"
    trap _s9_fdmap_cleanup EXIT

    local total_fds=0
    local total_procs=0

    for proc_dir in /proc/[0-9]*; do
        local pid="${proc_dir##*/}"
        local fd_dir="$proc_dir/fd"

        [[ -r "$fd_dir" ]] || continue

        local fd_count
        fd_count=$(ls -1 -- "$fd_dir" 2>/dev/null | wc -l)

        local name
        name=$(s9_get_comm "$pid")

        local user
        local uid
        uid=$(awk '/^Uid:/ {print $2}' "$proc_dir/status" 2>/dev/null)
        user=$(s9_uid_to_user "$uid")

        total_fds=$((total_fds + fd_count))
        ((total_procs++))

        echo "$fd_count|$pid|$name|$user" >> "$tmp_file"
    done

    if ! $JSON_MODE; then
        printf "  ${S9_BOLD}%-8s %-20s %-8s %s${S9_NC}\n" "PID" "PROCESS" "FDs" "USER"
        printf "  ${S9_DIM}────────────────────────────────────────────────────────────────${S9_NC}\n"
    fi

    # Sort by FD count descending and show top N
    local count=0
    local first=true

    # Guard: verify temp file has data before sorting to avoid silent empty output
    if [[ ! -s "$tmp_file" ]]; then
        s9_debug "No process data collected for FD summary"
    fi

    # Read sorted output
    while IFS='|' read -r fd_count pid name user; do
        [[ -z "$pid" ]] && continue
        ((count++))
        ((count > TOP_N)) && break

        if $JSON_MODE; then
            if $first; then first=false; else echo ","; fi
            echo "    {"
            s9_json_kv "pid" "$pid" "" "    "
            s9_json_kv "name" "$name" "" "    "
            s9_json_kv "fd_count" "$fd_count" "" "    "
            s9_json_kv "user" "$user" "last" "    "
            echo -n "    }"
        else
            # Color high FD counts
            local fd_color="$S9_NC"
            if (( fd_count >= LEAK_THRESHOLD )); then
                fd_color="$S9_RED"
            elif (( fd_count >= LEAK_THRESHOLD / 2 )); then
                fd_color="$S9_YELLOW"
            fi

            printf "  %-8s %-20s %b%-8s${S9_NC} ${S9_DIM}%s${S9_NC}\n" \
                "$pid" "${name:0:20}" "$fd_color" "$fd_count" "$user"
        fi
    done < <(sort -t'|' -k1 -rn "$tmp_file")

    if $JSON_MODE; then
        echo ""
        echo "  ],"
        echo "  \"stats\": {"
        s9_json_kv "total_processes" "$total_procs"
        s9_json_kv "total_fds" "$total_fds"

        # System-wide FD stats
        if [[ -r /proc/sys/fs/file-nr ]]; then
            local file_nr
            file_nr=$(cat /proc/sys/fs/file-nr)
            local allocated max
            allocated=$(echo "$file_nr" | awk '{print $1}')
            max=$(echo "$file_nr" | awk '{print $3}')
            s9_json_kv "system_allocated" "$allocated"
            s9_json_kv "system_max" "$max" "last"
        else
            s9_json_kv "system_allocated" "0"
            s9_json_kv "system_max" "0" "last"
        fi
        echo "  }"
        echo "}"
    else
        if (( total_procs > TOP_N )); then
            printf "  %b... and %d more processes%b\n" "${S9_DIM}" "$((total_procs - TOP_N))" "${S9_NC}"
        fi

        echo ""
        printf "%bTotal:%b %d processes, %d file descriptors\n" "${S9_BOLD}" "${S9_NC}" "$total_procs" "$total_fds"

        # System-wide FD stats
        if [[ -r /proc/sys/fs/file-nr ]]; then
            local file_nr
            file_nr=$(cat /proc/sys/fs/file-nr)
            local allocated max
            allocated=$(echo "$file_nr" | awk '{print $1}')
            max=$(echo "$file_nr" | awk '{print $3}')
            local percent
            if (( max > 0 )); then
                local int_val=$(( (allocated * 100) / max ))
                local dec_val=$(( ((allocated * 1000) / max) % 10 ))
                percent="${int_val}.${dec_val}"
            else
                percent="0.0"
            fi
            printf "%bSystem:%b %s / %s FDs allocated (%s%%)\n" "${S9_BOLD}" "${S9_NC}" "$allocated" "$max" "$percent"
        fi
    fi
}

find_file_users() {
    local target_file="$1"
    local canonical_target="$target_file"

    if command -v realpath >/dev/null 2>&1; then
        canonical_target=$(realpath -m "$target_file" 2>/dev/null || printf "%s" "$target_file")
    fi

    if $JSON_MODE; then
        echo "{"
        s9_json_kv "target_file" "$target_file"
        echo "  \"processes\": ["
    else
        printf "%bProcesses with '%s' open:%b\n" "${S9_BOLD}" "$target_file" "${S9_NC}"
        echo ""

        printf "  ${S9_BOLD}%-8s %-20s %-6s %s${S9_NC}\n" "PID" "PROCESS" "FD" "TARGET"
        printf "  ${S9_DIM}────────────────────────────────────────────────────────────────${S9_NC}\n"
    fi

    local found=0
    local first=true

    for proc_dir in /proc/[0-9]*; do
        local pid="${proc_dir##*/}"
        local fd_dir="$proc_dir/fd"

        [[ -r "$fd_dir" ]] || continue

        for fd in "$fd_dir"/*; do
            [[ -e "$fd" ]] || continue

            local target
            target=$(readlink "$fd" 2>/dev/null || echo "")

            if [[ "$target" == "$target_file" ]] ||
               [[ "$target" == "$target_file (deleted)" ]] ||
               [[ "$target" == "$canonical_target" ]] ||
               [[ "$target" == "$canonical_target (deleted)" ]]; then
                local name
                name=$(s9_get_comm "$pid")

                local fd_num="${fd##*/}"

                if $JSON_MODE; then
                    if $first; then first=false; else echo ","; fi
                    echo "    {"
                    s9_json_kv "pid" "$pid" "" "    "
                    s9_json_kv "name" "$name" "" "    "
                    s9_json_kv "fd" "$fd_num" "" "    "
                    s9_json_kv "target" "$target" "last" "    "
                    echo -n "    }"
                else
                    printf "  ${S9_CYAN}%-8s${S9_NC} %-20s ${S9_BOLD}%-6s${S9_NC} %s\n" \
                        "$pid" "${name:0:20}" "$fd_num" "${target:0:40}"
                fi

                ((found++))
            fi
        done
    done

    if $JSON_MODE; then
        echo ""
        echo "  ],"
        s9_json_kv "count" "$found" "last"
        echo "}"
    else
        if (( found == 0 )); then
            printf "  %bNo processes found with this file open%b\n" "${S9_DIM}" "${S9_NC}"
        else
            echo ""
            printf "%bFound:%b %d file descriptor(s) matching '%s'\n" "${S9_BOLD}" "${S9_NC}" "$found" "$target_file"
        fi
    fi
}

build_socket_inode_index() {
    SOCKET_INDEX=()

    local proc_dir pid fd_dir name fd target inode
    for proc_dir in /proc/[0-9]*; do
        pid="${proc_dir##*/}"
        fd_dir="$proc_dir/fd"

        [[ -r "$fd_dir" ]] || continue
        name=$(s9_get_comm "$pid")
        name="${name//|/}"

        for fd in "$fd_dir"/*; do
            [[ -e "$fd" ]] || continue
            target=$(readlink "$fd" 2>/dev/null || echo "")
            if [[ "$target" =~ ^socket:\[([0-9]+)\]$ ]]; then
                inode="${BASH_REMATCH[1]}"
                SOCKET_INDEX[$inode]="${SOCKET_INDEX[$inode]:-}${pid}|${name}"$'\n'
            fi
        done
    done
}

emit_socket_match() {
    local inode="$1"
    local protocol="$2"
    local local_addr="$3"
    local entries="${SOCKET_INDEX[$inode]:-}"

    [[ -n "$entries" ]] || return 0

    local pid name
    while IFS='|' read -r pid name; do
        [[ -n "$pid" ]] || continue

        if $JSON_MODE; then
            if $SOCKET_FIRST; then SOCKET_FIRST=false; else echo ","; fi
            echo "    {"
            s9_json_kv "pid" "$pid" "" "    "
            s9_json_kv "name" "$name" "" "    "
            s9_json_kv "protocol" "$protocol" "" "    "
            s9_json_kv "local_addr" "$local_addr" "last" "    "
            echo -n "    }"
        else
            printf "  ${S9_CYAN}%-8s${S9_NC} %-20s %-10s %s\n" \
                "$pid" "${name:0:20}" "$protocol" "$local_addr"
        fi

        ((SOCKET_FOUND++))
    done <<< "$entries"
}

scan_socket_table() {
    local table="$1"
    local protocol="$2"
    local port_hex="$3"

    [[ -r "$table" ]] || return 0

    local local_addr inode
    while read -r _ local_addr _ _ _ _ _ _ _ inode _; do
        [[ "$local_addr" == *":$port_hex" ]] || continue
        [[ -n "$inode" ]] || continue
        SOCKET_MATCHES[$inode]="$protocol|$local_addr"
    done < <(tail -n +2 "$table" 2>/dev/null)
}

scan_socket_table_set() {
    local net_dir="$1"
    local port_hex="$2"

    scan_socket_table "$net_dir/tcp" TCP "$port_hex"
    scan_socket_table "$net_dir/tcp6" TCP6 "$port_hex"
    scan_socket_table "$net_dir/udp" UDP "$port_hex"
    scan_socket_table "$net_dir/udp6" UDP6 "$port_hex"
}

scan_socket_namespaces() {
    local port_hex="$1"
    local -A seen_netns=()

    scan_socket_table_set /proc/net "$port_hex"

    local current_ns
    current_ns=$(readlink /proc/self/ns/net 2>/dev/null || echo "")
    [[ -n "$current_ns" ]] && seen_netns[$current_ns]=1

    local proc_dir ns_key
    for proc_dir in /proc/[0-9]*; do
        [[ -d "$proc_dir/net" ]] || continue

        ns_key=$(readlink "$proc_dir/ns/net" 2>/dev/null || echo "$proc_dir")
        [[ -n "$ns_key" ]] || ns_key="$proc_dir"
        [[ -n "${seen_netns[$ns_key]:-}" ]] && continue

        seen_netns[$ns_key]=1
        scan_socket_table_set "$proc_dir/net" "$port_hex"
    done
}

find_socket_users_indexed() {
    local target_port="$1"
    s9_validate_port "$target_port"
    local target_port_num=$((10#$target_port))

    if $JSON_MODE; then
        echo "{"
        s9_json_kv "target_port" "$target_port"
        echo "  \"processes\": ["
    else
        printf "%bProcesses using port %s:%b\n" "${S9_BOLD}" "$target_port" "${S9_NC}"
        echo ""
        printf "  ${S9_BOLD}%-8s %-20s %-10s %s${S9_NC}\n" "PID" "PROCESS" "PROTOCOL" "LOCAL ADDR"
        printf "  ${S9_DIM}----------------------------------------------------------------${S9_NC}\n"
    fi

    local port_hex
    port_hex=$(printf "%04X" "$target_port_num")

    SOCKET_FOUND=0
    SOCKET_FIRST=true
    SOCKET_MATCHES=()
    build_socket_inode_index
    scan_socket_namespaces "$port_hex"

    local inode match protocol local_addr
    for inode in "${!SOCKET_MATCHES[@]}"; do
        match="${SOCKET_MATCHES[$inode]}"
        IFS='|' read -r protocol local_addr <<< "$match"
        emit_socket_match "$inode" "$protocol" "$local_addr"
    done

    if $JSON_MODE; then
        echo ""
        echo "  ],"
        s9_json_kv "count" "$SOCKET_FOUND" "last"
        echo "}"
    else
        if (( SOCKET_FOUND == 0 )); then
            printf "  %bNo processes found using port %s%b\n" "${S9_DIM}" "$target_port" "${S9_NC}"
        else
            echo ""
            printf "%bFound:%b %d connection(s) on port %s\n" "${S9_BOLD}" "${S9_NC}" "$SOCKET_FOUND" "$target_port"
        fi
    fi
}

detect_leaks() {
    if $JSON_MODE; then
        echo "{"
        s9_json_kv "threshold" "$LEAK_THRESHOLD"
        echo "  \"leaks\": ["
    else
        s9_box_title "Substrata9 — FD Leak Detection" "Threshold: $LEAK_THRESHOLD FDs"

        printf "  ${S9_BOLD}%-8s %-20s %-8s %-18s %s${S9_NC}\n" "PID" "PROCESS" "FDs" "BREAKDOWN" "USER"
        printf "  ${S9_DIM}──────────────────────────────────────────────────────────────────────${S9_NC}\n"
    fi

    local found=0
    local first=true

    for proc_dir in /proc/[0-9]*; do
        local pid="${proc_dir##*/}"
        local fd_dir="$proc_dir/fd"

        [[ -r "$fd_dir" ]] || continue

        local fd_count
        fd_count=$(ls -1 -- "$fd_dir" 2>/dev/null | wc -l)

        if (( fd_count >= LEAK_THRESHOLD )); then
            local name
            name=$(s9_get_comm "$pid")

            local user
            local uid
            uid=$(awk '/^Uid:/ {print $2}' "$proc_dir/status" 2>/dev/null)
            user=$(s9_uid_to_user "$uid")

            # Count FD types
            local files=0 sockets=0 pipes=0 other=0
            for fd in "$fd_dir"/*; do
                [[ -e "$fd" ]] || continue
                local target
                target=$(readlink "$fd" 2>/dev/null || echo "")

                case "$target" in
                    socket:*) ((sockets++)) ;;
                    pipe:*) ((pipes++)) ;;
                    /dev/*|anon_inode:*) ((other++)) ;;
                    *) ((files++)) ;;
                esac
            done

            local breakdown="${files}f/${sockets}s/${pipes}p/${other}o"

            if $JSON_MODE; then
                if $first; then first=false; else echo ","; fi
                echo "    {"
                s9_json_kv "pid" "$pid" "" "    "
                s9_json_kv "name" "$name" "" "    "
                s9_json_kv "fd_count" "$fd_count" "" "    "
                s9_json_kv "breakdown" "$breakdown" "" "    "
                s9_json_kv "user" "$user" "last" "    "
                echo -n "    }"
            else
                # Color based on severity
                local fd_color="$S9_YELLOW"
                if (( fd_count >= LEAK_THRESHOLD * 5 )); then
                    fd_color="$S9_RED"
                fi

                printf "  ${S9_RED}%-8s${S9_NC} %-20s %b%-8s${S9_NC} %-18s ${S9_DIM}%s${S9_NC}\n" \
                    "$pid" "${name:0:20}" "$fd_color" "$fd_count" "$breakdown" "$user"
            fi

            ((found++))
        fi
    done

    if $JSON_MODE; then
        echo ""
        echo "  ],"
        s9_json_kv "count" "$found" "last"
        echo "}"
    else
        if (( found == 0 )); then
            printf "  ${S9_GREEN}✓ No potential leaks detected${S9_NC}\n"
        else
            echo ""
            printf "%b! Found %d process(es) with high FD counts%b\n" "${S9_YELLOW}" "$found" "${S9_NC}"
            echo ""
            printf "%bBreakdown legend: f=files, s=sockets, p=pipes, o=other%b\n" "${S9_DIM}" "${S9_NC}"
            printf "%bUse 's9-inspect <PID>' for detailed FD analysis%b\n" "${S9_DIM}" "${S9_NC}"
        fi
    fi
}

#------------------------------------------------------------------------------
# Main
#------------------------------------------------------------------------------

usage() {
    printf "%bs9-fdmap%b - File descriptor mapping across processes\n" "$S9_BOLD" "$S9_NC"
    printf "Substrata9 v%s\n\n" "$S9_VERSION"

    printf "%bUSAGE:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    s9-fdmap [options]\n\n"

    printf "%bOPTIONS:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    --file PATH         Find which processes have this file open\n"
    printf "    --socket PORT       Find which processes use this port\n"
    printf "    --leaks             Detect processes with high FD counts\n"
    printf "    --threshold N       FD count threshold for leak detection (default: 100)\n"
    printf "    --top N             Show top N processes in summary (default: 20)\n"
    printf "    -j, --json          Output in JSON format\n"
    printf "    -e, --export-json   Export JSON to an auto-named file\n"
    printf "    -q, --quiet         Minimal output (for scripting)\n"
    printf "    -h, --help          Show this help\n"


    printf "%bEXAMPLES:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    s9-fdmap                            # System-wide summary (sorted by FD count)\n"
    printf "    s9-fdmap --file /var/log/syslog     # Who has this file open?\n"
    printf "    s9-fdmap --socket 8080              # Who is using port 8080?\n"
    printf "    s9-fdmap --leaks --threshold 50     # Find potential FD leaks\n"
    printf "    s9-fdmap --json | jq .              # Output as JSON\n\n"

    printf "%bOUTPUT:%b\n" "$S9_BOLD" "$S9_NC"
    printf "    Summary mode shows processes sorted by FD count (highest first).\n"
    printf "    Leak detection shows breakdown: files/sockets/pipes/other\n"

    exit 0
}

fdmap_export_purpose() {
    if [[ -n "$SEARCH_FILE" ]]; then
        echo "fdmap-file"
    elif [[ -n "$SEARCH_SOCKET" ]]; then
        echo "fdmap-socket"
    elif $FIND_LEAKS; then
        echo "fdmap-leaks"
    else
        echo "fdmap-summary"
    fi
}

run_fdmap() {
    if ! $JSON_MODE; then
        echo ""
    fi

    if [[ -n "$SEARCH_FILE" ]]; then
        find_file_users "$SEARCH_FILE"
    elif [[ -n "$SEARCH_SOCKET" ]]; then
        find_socket_users_indexed "$SEARCH_SOCKET"
    elif $FIND_LEAKS; then
        detect_leaks
    else
        system_summary
    fi

    if ! $JSON_MODE; then
        echo ""
    fi
}

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --file)
                [[ $# -ge 2 ]] || s9_die "--file requires a path"
                SEARCH_FILE="$2"
                shift 2
                ;;
            --socket)
                [[ $# -ge 2 ]] || s9_die "--socket requires a port"
                SEARCH_SOCKET="$2"
                shift 2
                ;;
            --leaks)
                FIND_LEAKS=true
                shift
                ;;
            --threshold)
                [[ $# -ge 2 ]] || s9_die "--threshold requires a value"
                [[ "$2" =~ ^[0-9]+$ ]] || s9_die "Threshold must be a number"
                LEAK_THRESHOLD=$((10#$2))
                shift 2
                ;;
            --top)
                [[ $# -ge 2 ]] || s9_die "--top requires a value"
                [[ "$2" =~ ^[0-9]+$ ]] || s9_die "Top N must be a number"
                TOP_N=$((10#$2))
                shift 2
                ;;
            -j|--json)
                JSON_MODE=true
                shift
                ;;
            -e|--export-json)
                AUTO_EXPORT_JSON=true
                JSON_MODE=true
                shift
                ;;
            -q|--quiet)
                QUIET_MODE=true
                shift
                ;;
            -h|--help)
                usage
                ;;
            *)
                s9_die "Unknown option: $1. Use --help for usage."
                ;;
        esac
    done

    if $AUTO_EXPORT_JSON && $QUIET_MODE; then
        s9_die "-e cannot be combined with --quiet"
    fi

    # Run environment checks after handling cheap flags like --help.
    s9_init

    # Quiet mode: output counts only
    if $QUIET_MODE; then
        local total_fds=0 total_procs=0 leaks=0
        for proc_dir in /proc/[0-9]*; do
            local pid="${proc_dir##*/}"
            [[ -r "$proc_dir/fd" ]] || continue
            local fd_count
            fd_count=$(ls -1 -- "$proc_dir/fd" 2>/dev/null | wc -l)
            total_fds=$((total_fds + fd_count))
            ((total_procs++))
            if (( fd_count >= LEAK_THRESHOLD )); then ((leaks++)); fi
        done
        echo "PROCESSES=$total_procs TOTAL_FDS=$total_fds POTENTIAL_LEAKS=$leaks"
        return 0
    fi

    if $AUTO_EXPORT_JSON; then
        local export_file
        export_file=$(s9_auto_export_path "$(fdmap_export_purpose)")
        s9_export_json_output "$export_file" run_fdmap
    else
        run_fdmap
    fi
}

main "$@"
